rules_version = '2';

// גולשים באתר יכולים רק לקרוא את האוספים הציבוריים.
// כל הכתיבה נעשית מבוט הטלגרם דרך Admin SDK, שלא כפוף לחוקים האלה.
// כל אוסף שלא מופיע כאן חסום לגמרי.
service cloud.firestore {
  match /databases/{database}/documents {
    match /testimonials/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
